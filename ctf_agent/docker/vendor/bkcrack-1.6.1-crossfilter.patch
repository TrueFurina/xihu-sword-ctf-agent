diff -ruN '--exclude=obj' base/bkcrack-1.6.1/src/main.cpp mod/bkcrack-1.6.1/src/main.cpp
--- a/bkcrack-1.6.1/src/main.cpp	2024-01-23 05:38:27.000000000 +0800
+++ b/bkcrack-1.6.1/src/main.cpp	2026-10-09 14:03:08.997627000 +0800
@@ -13,6 +13,13 @@
 #include <cassert>
 #include <iomanip>
 #include <limits>
+#include <cstdio>
+
+#define SECOND_CIPHERTEXT_FILENAME "second_ciphertext"
+#define SECOND_PLAINTEXT_FILENAME "second_plaintext"
+char second_ciphertext[16];
+char second_plaintext[5];
+bool g_second_file = false;
 
 namespace
 {
@@ -107,6 +114,35 @@
     // enable virtual terminal support on Windows, no-op on other platforms
     VirtualTerminalSupport vtSupport;
 
+    // read in second ciphertext and second plaintext if present (ziphhard cross-file filter)
+    {
+        FILE *fp = fopen(SECOND_CIPHERTEXT_FILENAME, "rb");
+        if (fp)
+        {
+            fseek(fp, 0L, SEEK_END);
+            long sz = ftell(fp);
+            fseek(fp, 0L, SEEK_SET);
+            if (sz == 16 && fread(second_ciphertext, 1, 16, fp) == 16)
+            {
+                fclose(fp);
+                fp = fopen(SECOND_PLAINTEXT_FILENAME, "rb");
+                if (fp)
+                {
+                    fseek(fp, 0L, SEEK_END);
+                    long psz = ftell(fp);
+                    fseek(fp, 0L, SEEK_SET);
+                    if (psz == 5 && fread(second_plaintext, 1, 5, fp) == 5)
+                        g_second_file = true;
+                    fclose(fp);
+                }
+            }
+            else
+                fclose(fp);
+        }
+        if (g_second_file)
+            std::cout << "second-file cross-filter enabled" << std::endl;
+    }
+
     // version information
     std::cout << "bkcrack " BKCRACK_VERSION " - " BKCRACK_VERSION_DATE << std::endl;
 
