diff -ruN '--exclude=obj' base/bkcrack-1.6.1/src/Attack.cpp mod/bkcrack-1.6.1/src/Attack.cpp
--- a/bkcrack-1.6.1/src/Attack.cpp	2024-01-23 05:38:27.000000000 +0800
+++ b/bkcrack-1.6.1/src/Attack.cpp	2026-10-09 14:03:41.103124800 +0800
@@ -6,6 +6,11 @@
 #include <algorithm>
 #include <atomic>
 #include <thread>
+#include <cstring>
+
+extern char second_ciphertext[16];
+extern char second_plaintext[5];
+extern bool g_second_file;
 
 Attack::Attack(const Data& data, std::size_t index, std::vector<Keys>& solutions, std::mutex& solutionsMutex, bool exhaustive, Progress& progress)
  : data(data), index(index + 1 - Attack::CONTIGUOUS_SIZE), solutions(solutions), solutionsMutex(solutionsMutex), exhaustive(exhaustive), progress(progress)
@@ -163,6 +168,28 @@
     // get the keys associated with the initial state
     keysBackward.updateBackward(data.ciphertext, indexBackward, 0);
 
+    // the keys seem correct based on eight contiguous bytes, now check the second file
+    // NOTE: must run AFTER the rewind above. keysBackward must hold the password-init
+    // state (shared by every entry under the same password) before it can decrypt the
+    // second file's 12-byte encryption header + 4-byte ciphertext. Testing the
+    // mid-stream state of the first file rejects EVERY true candidate, which shows up
+    // as "100% scanned, Could not find the keys" (bug found 2026-10-09, GCTF23 ziphard;
+    // verified by synthetic known-password zip: fixed build finds the true keys,
+    // pre-fix build rejects them).
+    if(g_second_file)
+    {
+        Keys keysTest(keysBackward.getX(), keysBackward.getY(), keysBackward.getZ());
+        char poss_plaintext[16];
+        for (int i = 0; i < 16; ++i)
+        {
+            char p = static_cast<char>(second_ciphertext[i] ^ keysTest.getK());
+            poss_plaintext[i] = p;
+            keysTest.update(static_cast<byte>(p));
+        }
+        if (memcmp(poss_plaintext + 11, second_plaintext, 5) != 0)
+            return;
+    }
+
     {
         const auto lock = std::scoped_lock{solutionsMutex};
         solutions.push_back(keysBackward);
