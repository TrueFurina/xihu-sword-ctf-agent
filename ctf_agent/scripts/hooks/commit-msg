#!/usr/bin/env bash
# commit-msg 钩子：commit message 假水位拦截（2026-08-23，堵 99fb169 类）
#   git 传 $1 = commit message 文件路径（机制上可靠，不靠猜 COMMIT_EDITMSG 位置）
#   message 命中假水位（解出数递增 / 真实解出 flag / +N 真实解出）→ exit 1 拒绝提交
#
# 安装：cp scripts/hooks/commit-msg git_hooks/commit-msg（core.hooksPath=git_hooks）
# 与 pre-commit 门禁分工：本钩子只管 message 文本；文件/密钥/租约/身份/测试在 pre-commit。
set -e

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)/ctf_agent"
PY="$ROOT/.venv/Scripts/python.exe"
if [ ! -x "$PY" ] && [ ! -f "$PY" ]; then
    PY="python"
fi

# git 传 $1 为相对仓库根的 commit message 路径；cd 到 ctf_agent 子目录后会失效，先转绝对路径
GIT_TOP="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -n "$1" ]; then
    MSG_ABS="$GIT_TOP/$1"
    [ -f "$MSG_ABS" ] || MSG_ABS="$1"
else
    MSG_ABS=""
fi

cd "$ROOT"
"$PY" scripts/_honesty_scan.py --commit-msg-file "$MSG_ABS"

# ── ⑨ 任务板登记闸（2026-08-24 并发有序化闸1，堵"裸奔提交"；2026-08-28 包工头强化）──
# commit message 必须满足其一：
#   (a) 含 T-xx（TASK_BOARD 认领的任务 id）——功能/修复/解题类必须挂任务；
#   (b) 含 [无任务:说明]（带括号说明的治理/文档/门禁类，如 [无任务:治理]/[无任务:文档]）。
# 纯 [无任务]（无说明）= 裸奔提交 → 拒绝（包工头 2026-08-28 指令 R0：禁止把 [无任务]
#   当"懒登记"借口；治理类也须写明性质，便于总账审计）。
# 说明：gu 全域长租约 + 任务板零登记是"并发裸奔"实证（2026-08-24 监管取证），
# 本闸把"认领即承诺"从自觉变成机器强制。
MSG_FILE="$MSG_ABS"
if grep -qE 'T-[0-9]+' "$MSG_FILE"; then
    # (a) 挂任务板，放行
    :
elif grep -qE '\[无任务:[^]]+\]' "$MSG_FILE"; then
    # (b) 带说明的无任务标注，放行
    :
else
    echo "❌ 任务板登记缺失（2026-08-28 包工头强化）：commit message 须满足其一——"
    echo "   1) 含 T-xx（TASK_BOARD 认领的任务 id）：功能/修复/解题类必须挂任务"
    echo "   2) 含 [无任务:说明]：治理/文档/门禁类须写明性质，如 [无任务:治理]/[无任务:文档]"
    echo "   纯 [无任务] 视为裸奔提交（禁止当懒登记借口）——先看 TASK_BOARD.md 认领或补说明"
    echo "   （否则就是裸奔提交——2026-08-24 闸1 + 2026-08-28 R0）"
    exit 1
fi
