#!/usr/bin/env bash
# pre-commit 六门禁钩子
#   ① 密钥扫描（P0-1 防回归，2026-08-21）：暂存区命中 ak_live_/sk-*/DASCTF_TOKEN= 明文即拒
#   ② 诚实口径扫描（2026-08-23）：暂存区 .md 命中假水位（解出数递增/真实解出 flag/+N 真实解出）即拒
#   ③ 写者租约门禁（治理，2026-08-22；2026-08-22 补丁：焊死"靠自觉性激活"缺口）：
#      无会话标识且无单人模式→默认拒绝（exit 1）；租约属别人→拒；属自己→scope 越界拒 + 自动续租
#   ④ git 身份绑定校验（2026-08-23，堵 P1-7）：commit author 必须 == 会话 id，
#      否则所有 commit 同一 author、租约持有者无法在 git 层映射/审计
#   ⑤ commit message 假水位拦截 → 由独立 git_hooks/commit-msg 钩子负责（$1 传 message 路径，更可靠）
#   ⑥ 快速回归门禁（2026-08-23，堵"测试红提交"——锐评 P0-1 假门禁）：
#      commit 级跑防错体系核心测试（机制自检，<10s）；全量 pytest 由 Reviewer gate 在 merge 前负责
#
# 安装（仓库根目录，Windows Git Bash）：
#   cp scripts/hooks/pre-commit git_hooks/pre-commit   # 本项目用 core.hooksPath=git_hooks，非 .git/hooks
#   cp scripts/hooks/commit-msg git_hooks/commit-msg
#   （git_hooks/ 为激活位、随仓库追踪；scripts/hooks/ 为源，setup.sh 同步）
# 会话归属（hook 如何知道"我是谁"，二选一，优先级从高到低）：
#   环境变量 CT_AGENT_SESSION=xxx（推荐，每个 AI 会话 export 自己的标识）
#   git config atomcode.session xxx（会话级/仓库级，无环境变量时兜底）
#
# 行为：任一门禁失败 exit 1 阻断提交；六者都过才提交。
set -e

# 仓库根目录：用 git 自身定位，避免依赖钩子所在层级
# （core.hooksPath=git_hooks 时钩子在 <root>/git_hooks/；旧式 .git/hooks 时深两级——
#  硬编码 ../.. 会在 git_hooks 模式下把 ROOT 算到仓库父目录，导致扫描脚本找不到文件、
#  误杀所有提交。2026-08-22 修。）
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)/ctf_agent" || ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PY="$ROOT/.venv/Scripts/python.exe"
if [ ! -x "$PY" ] && [ ! -f "$PY" ]; then
    PY="python"
fi

cd "$ROOT"

# ── ① 密钥扫描 ──
"$PY" scripts/_scan_secrets.py --cached

# ── ② 诚实口径扫描（假水位拦截，2026-08-23）──
"$PY" scripts/_honesty_scan.py --cached

# （commit message 假水位拦截 2026-08-23 由独立 commit-msg 钩子负责——
#   git 传 message 文件路径作 $1，比 pre-commit 里猜 COMMIT_EDITMSG 位置可靠）

# ── ③ 写者租约门禁 ──
SESSION="${CT_AGENT_SESSION:-}"
if [ -z "$SESSION" ]; then
    SESSION="$(git config --get atomcode.session || true)"
fi
if [ -z "$SESSION" ]; then
    # 无会话标识：默认拒绝（机器执法不靠自觉性激活）
    # 仅当显式单人调试模式 CT_AGENT_SINGLE=1 且确认无并行 AI 会话时放行
    if [ -n "${CT_AGENT_SINGLE:-}" ]; then
        echo "ℹ️ lease: 单人调试模式（CT_AGENT_SINGLE=1）放行——请确保当前无并行 AI 会话，否则本放行使 CTDE 门禁失效"
        exit 0
    fi
    echo "❌ lease: 无会话标识且无单人模式，多会话环境禁止无租约提交。"
    echo "   处置二选一："
    echo "     1) 多会话协同：export CT_AGENT_SESSION=<你的会话名>，再 scripts/_lease.py acquire 租约后提交"
    echo "     2) 单人调试且确认无并行会话：export CT_AGENT_SINGLE=1 后重试"
    echo "   切勿为图省事长期设 CT_AGENT_SINGLE=1 提交——那正是初赛 0 分'多会话无锁并发'的根因"
    exit 1
fi
"$PY" scripts/_lease.py precommit --session "$SESSION"

# ── ③.5 main 直提拦截（2026-08-24 阶段3 红绿灯：main 只走合并闸门）──
# main 分支直接 commit（无 MERGE_HEAD / 无 SQUASH_MSG）→ 拒绝。
# 工人会话必须在 w/* 车道提交，main 只通过 merge/squash 由闸门收口。
CUR_BRANCH="$(git branch --show-current 2>/dev/null)"
IS_MERGE=0
[ -f "$(git rev-parse --git-path MERGE_HEAD 2>/dev/null)" ] && IS_MERGE=1
[ -f "$(git rev-parse --git-path SQUASH_MSG 2>/dev/null)" ] && IS_MERGE=1
if [ "$CUR_BRANCH" = "main" ] && [ "$IS_MERGE" = "0" ]; then
    echo "❌ main 直提拦截（阶段3 红绿灯）：main 分支禁止直接提交"
    echo "   处置：在 w/<任务名> 车道提交（git worktree add ../wt-<任务名> -b w/<任务名>），"
    echo "         再通过合并闸门（pre-merge-commit + _merge_gate.py）合入 main"
    exit 1
fi

# ── ④ git 身份绑定校验（堵 P1-7：author 必须 == session）──
# P0-2（2026-08-24）：默认告警（不硬拦，避免误伤在飞会话）；CT_AGENT_IDENTITY_ENFORCE=1
# 时硬拦（正式赛/benchmark 跑分前开启，禁止身份覆盖）。bind_at 留痕供审计。
AUTHOR="$(git config user.name || true)"
if [ "$AUTHOR" != "$SESSION" ]; then
    LASTBIND="$("$PY" scripts/_sign.py last-bind --session "$SESSION" 2>/dev/null || true)"
    if [ -z "$AUTHOR" ]; then
        echo "⚠️ 身份脱钩：git author 未设置，无法映射会话「$SESSION」"
    else
        echo "⚠️ 身份脱钩：git author「$AUTHOR」≠ 会话「$SESSION」"
    fi
    [ -n "$LASTBIND" ] && echo "   （该会话最近一次 bind 留痕：$LASTBIND——请核对是否被其他会话覆盖）"
    if [ -n "${CT_AGENT_IDENTITY_ENFORCE:-}" ]; then
        echo "❌ CT_AGENT_IDENTITY_ENFORCE=1 硬拦：禁止身份覆盖"
        echo "   处置：scripts/_sign.py bind --session $SESSION 恢复身份后再提交"
        exit 1
    fi
    echo "   （默认告警模式：可继续提交，但请在正式赛/跑分前开启 CT_AGENT_IDENTITY_ENFORCE=1）"
fi

# ── ⑥ 快速回归门禁（2026-08-23，堵"测试红提交"——锐评 P0-1 假门禁）──
# commit 级跑防错体系核心测试（机制自检，<10s）。全量 pytest -m "not slow" 由
# Reviewer gate（scripts/_reviewer_gate.py，merge 前）负责；此处只保证"门禁机制自身
# 没被改坏"，不是"本次改动功能全绿"——两者分工明确，避免每 commit 都跑 30s+ 全量。
# 2026-08-23 扩充：加入 reviewer/task_board/coupling/closeout（防错体系全脚本，71 用例 <3s）
echo "── ⑥ 快速回归（防错体系核心测试）──"
"$PY" -m pytest \
    tests/test_lease.py tests/test_lease_multiwriter.py \
    tests/test_sign.py tests/test_honesty_scan.py \
    tests/test_doc_consistency.py tests/test_facts.py \
    tests/test_reviewer_gate.py tests/test_task_board.py \
    tests/test_coupling_cluster.py tests/test_closeout.py \
    -q --no-header

# ── ⑦ 文档一致性真实扫描（2026-08-23，堵 P1-6"三方谎言"复发）──
# 防错体系单测只测脚本逻辑（mock 输入）；这里跑脚本本体扫真实文档：
# 文档断言（如"单写者全局租约"）与实现漂移 → 拒绝提交。
"$PY" scripts/_doc_consistency.py

# ── ⑧ merge 全量门禁（2026-08-23 锐评 P0-1 实装：堵"merge 带红"；2026-08-24 阶段3 增强：
#    合并闸门二合一——KPI 不降断言 + 全量 pytest，见 scripts/_merge_gate.py）──
# git 无 pre-merge hook（旧注释；git 2.24+ 已有 pre-merge-commit，见 git_hooks/pre-merge-commit）。
# merge 进行中 pre-commit 也会触发，用 MERGE_HEAD 判定（squash-merge 也设置 MERGE_HEAD）。
# 普通 commit 保持 ⑥ 快速回归（<10s）不阻塞协作——分工：commit 级快速、merge 级全量。
if [ -f "$(git rev-parse --git-path MERGE_HEAD 2>/dev/null)" ]; then
    echo "── ⑧ merge 全量门禁（merge 进行中：KPI 不降断言 + 全量 pytest）──"
    "$PY" scripts/_merge_gate.py
fi

# ── ⑪ 目录结构守卫（2026-08-28：防 agent 散写文件堆积）──
# 拦截向仓库根目录 / deliverables 根 / idea-stage 根 新增散落文件（白名单除外，fail-closed）。
# 仅检查本次新增（--diff-filter=A），不误伤既有/重命名；自身异常 fail-open（不阻断提交）。
# 规则与白名单见仓库根 AGENTS.md；手动全量自检：python scripts/check_structure.py --all
echo "── ⑪ 目录结构守卫 ──"
"$PY" scripts/_structure_guard.py
